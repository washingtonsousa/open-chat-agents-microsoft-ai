{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=chatbot;Username=postgres;Password=postgres"
  },
  "AppSettings": {
    "AppName": "OpenChatAgents",
    "OllamaBaseUrl": "http://localhost:11434",
    "LlmModel": "gemma3",
    "CorsOrigins": [ "http://localhost:3000" ],
    "Aws": {
      "Region": "us-east-1",
      "AccessKeyId": "",
      "SecretAccessKey": ""
    },
    "Jwt": {
      "Secret": "dev-only-secret-change-me-in-production-32chars-min",
      "Issuer": "OpenChatAgents",
      "Audience": "OpenChatAgents",
      "ExpiryMinutes": 480
    },
    "Minio": {
      "Endpoint": "localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "Bucket": "kb-documents",
      "UseSsl": false
    },
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "Username": "guest",
      "Password": "guest",
      "ExchangeName": "minio-events",
      "QueueName": "kb-ingestion"
    },
    "Weaviate": {
      "RestEndpoint": "localhost",
      "RestPort": 8085,
      "GrpcEndpoint": "localhost",
      "GrpcPort": 50051,
      "UseSsl": false
    },
    "Argon2": {
      "MemoryKb": 19456,
      "Iterations": 2,
      "Parallelism": 4
    },
    "Telemetry": {
      "Enabled": true,
      "OtlpEndpoint": "http://localhost:3001/api/public/otel",
      "LangfusePublicKey": "",
      "LangfuseSecretKey": "",
      "CaptureSensitiveContent": false
    }
  }
}
